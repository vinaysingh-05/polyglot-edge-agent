# Runtime configuration. Never commit real values.
POLYGLOT_ENV=production
POLYGLOT_API_KEY=replace-with-a-secret
GEMINI_API_KEY=replace-with-your-gemini-key
GEMINI_MODEL=gemini-3.8-flash
DATABASE_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres
POLYGLOT_ALLOWED_ORIGINS=https://your-frontend.example
POLYGLOT_MAX_REQUEST_BYTES=128000
POLYGLOT_MAX_PROMPT_CHARS=12000
POLYGLOT_CONTEXT_TOKEN_LIMIT=4096
POLYGLOT_INFERENCE_TIMEOUT_SECONDS=120
POLYGLOT_READINESS_CACHE_SECONDS=300
POLYGLOT_RATE_LIMIT_REQUESTS=30
POLYGLOT_RATE_LIMIT_WINDOW_SECONDS=60

# Configure GEMINI_API_KEY through the deployment platform's secret store.
# Do not put real API keys in this file.
