{
  "manifest_version": 3,
  "name": "Polyglot Proxy Gate",
  "version": "1.0",
  "description": "Intercepts prompts and routes them through Polyglot Proxy.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_title": "Polyglot Proxy Gate",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
